-- Cycle-scoped only: cleared by clearShownHistory when every notify_eligible
-- fact has been shown once (see design.md decision 4 / daily-fact-notifications
-- spec). Must NOT be reused for anything durable (e.g. the streak) - see
-- decision 9's correction and AppOpenLog.sq for why.
CREATE TABLE notificationShownFact (
    factId TEXT NOT NULL PRIMARY KEY,
    shownAtEpochMillis INTEGER NOT NULL
);

markShown:
INSERT OR REPLACE INTO notificationShownFact(factId, shownAtEpochMillis)
VALUES (?, ?);

allShownFactIds:
SELECT factId FROM notificationShownFact;

clearShownHistory:
DELETE FROM notificationShownFact;
