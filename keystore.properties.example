# Copy this file to keystore.properties (already gitignored) and fill in
# real values. Needed to produce a signed release build (./gradlew bundleRelease).
#
# Generate a keystore with:
#   keytool -genkeypair -v -keystore ~/android-keystores/bitcoin-bites-upload.jks \
#     -alias bitcoin-bites-upload -keyalg RSA -keysize 2048 -validity 10000
#
# Never commit the .jks file or keystore.properties itself - both are gitignored.

storeFile=/absolute/path/to/bitcoin-bites-upload.jks
storePassword=
keyAlias=bitcoin-bites-upload
keyPassword=
